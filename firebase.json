{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "trivia-ia-app",
          "appId": "1:1049545801330:android:bb4b3946c9eefa6ad18ceb",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "trivia-ia-app",
          "configurations": {
            "android": "1:1049545801330:android:bb4b3946c9eefa6ad18ceb",
            "ios": "1:1049545801330:ios:0c3a80dd0023086ed18ceb",
            "macos": "1:1049545801330:ios:0c3a80dd0023086ed18ceb",
            "web": "1:1049545801330:web:106566f7fbb7ea01d18ceb",
            "windows": "1:1049545801330:web:b22d3cf9ae3c9e11d18ceb"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
