rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /fixed_categories/{docId} {
      allow read: if request.auth != null;
    }

    match /fixed_pools/{categoryId}/{document=**} {
      allow read: if request.auth != null;
    }

    // Cloud-Function-only (createAiTopic / ensureAiTopicLevelsGenerated /
    // regenerateAiTopicQuestions / ensureTopicAdoptedIntoPool, Admin SDK —
    // bypasses these rules). Shared AI-topic content pool, same trust level
    // as fixed_pools above: read-open to any signed-in user since it's
    // moderated, non-personal content, but only Cloud Functions may write
    // it (a client write here could forge `usageCount`/`status` or plant
    // self-authored question content shared across every reuser).
    match /ai_topic_pool/{poolId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /{document=**} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Cloud-Function-only (consumeAiBudget, Admin SDK — bypasses these
    // rules). Daily Claude spend counters, project-wide and per account.
    // Fully closed, reads included: these are the ceilings that bound real
    // Anthropic billing, so a client must be able neither to reset a
    // counter nor to read how much of today's budget is left and pace
    // itself just under it.
    match /ai_usage/{dateId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /usernames/{usernameLower} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Economy fields (coins/xp/rating/streaks/season/daily-challenge
    // tracking) are now computed and written server-side by Cloud
    // Functions (finalizePvpMatch, finalizeAsyncPvpMatch,
    // claimPvpSeasonRewards, submitDailyChallengeResult) — the client may
    // no longer write them directly. `unlockedAvatars`/`dynamicAvatars`
    // (which weekly-topic/achievement avatars a player has earned, granted
    // by submitDailyChallengeResult / claimWeeklyTopicCompletionReward) are
    // protected the same way, so a modified client can't unlock cosmetics
    // it never earned. Everything else on this doc (profile fields, which
    // cosmetic is currently equipped, etc.) stays client-writable — see
    // avatarIdFieldValid()/equippedFrameFieldValid() below for the equip
    // actions specifically. More fields move into this list as later
    // phases land.
    function economyProtectedFields() {
      return [
        'coins', 'xp', 'level',
        'pvpRating', 'pvpRatingDelta', 'pvpLeagueId', 'pvpLeagueName',
        'bestLeagueId', 'bestLeagueName', 'bestLeagueEmoji',
        'bestLeagueColorValue',
        'currentPvpSeasonId', 'pvpSeasonBestRating',
        'pvpSeasonBestLeagueId', 'pvpSeasonBestLeagueName',
        'pvpSeasonFinalRating', 'pvpSeasonFinalLeagueId',
        'pvpSeasonFinalLeagueName',
        'pvpAbandonCount', 'pvpCooldownUntil', 'lastPvpPenaltyReason',
        'wins1v1', 'losses1v1', 'draws1v1', 'matches1v1',
        'currentWinStreak1v1', 'bestWinStreak1v1',
        'lastRankedXpEarned', 'lastRankedCoinsEarned',
        'lastClaimedPvpSeasonId', 'lastPvpSeasonRewardCoins',
        'lastPvpSeasonRewardCount', 'lastPvpSeasonRewardClaimedAt',
        'dailyStreak', 'maxDailyStreak', 'lastDailyPlayed', 'bestDailyScore',
        'leagueScore', 'leagueId', 'leagueName',
        'gamesPlayed', 'correctAnswers', 'wrongAnswers',
        'loginStreak', 'lastLoginDate',
        'pvpCoinsToday', 'pvpCoinsDate',
        'unlockedAvatars', 'dynamicAvatars',
        'categoriesExploredCount', 'weeklyTopicsCompletedCount',
        'lifeUnits', 'maxLifeUnits', 'lifeRegenSeconds', 'lastLifeTickAt'
      ];
    }

    // Mirrors FrameService.unlockedLeagueFrames() — the leagues a player
    // has ever reached (bestLeagueId, server-protected above) unlock every
    // frame at or below that rank.
    function unlockedFramesForLeague(bestLeagueId) {
      return bestLeagueId == 'master'
        ? ['bronze', 'silver', 'gold', 'platinum', 'diamond', 'master']
        : bestLeagueId == 'diamond'
        ? ['bronze', 'silver', 'gold', 'platinum', 'diamond']
        : bestLeagueId == 'platinum'
        ? ['bronze', 'silver', 'gold', 'platinum']
        : bestLeagueId == 'gold'
        ? ['bronze', 'silver', 'gold']
        : bestLeagueId == 'silver'
        ? ['bronze', 'silver']
        : ['bronze'];
    }

    // Mirrors AvatarService.unlockedAvatarIdsForBestLeague() — PvP avatars
    // are never persisted into unlockedAvatars (they're derived purely
    // from bestLeagueId at picker-render time on the client), so the rule
    // has to recognize them the same way or a legitimately-earned PvP
    // avatar could never be equipped.
    function pvpAvatarsForLeague(bestLeagueId) {
      return bestLeagueId == 'master'
        ? ['pvp_bronze', 'pvp_silver', 'pvp_gold', 'pvp_platinum', 'pvp_diamond', 'pvp_master']
        : bestLeagueId == 'diamond'
        ? ['pvp_bronze', 'pvp_silver', 'pvp_gold', 'pvp_platinum', 'pvp_diamond']
        : bestLeagueId == 'platinum'
        ? ['pvp_bronze', 'pvp_silver', 'pvp_gold', 'pvp_platinum']
        : bestLeagueId == 'gold'
        ? ['pvp_bronze', 'pvp_silver', 'pvp_gold']
        : bestLeagueId == 'silver'
        ? ['pvp_bronze', 'pvp_silver']
        : ['pvp_bronze'];
    }

    // A client may still equip a cosmetic (avatarId/equippedFrame), just
    // not fabricate one: avatarId must be either in the server-granted
    // unlockedAvatars list (base/weekly/achievement avatars) or a PvP
    // avatar unlocked for the player's own bestLeagueId; equippedFrame
    // must be unlocked for that same bestLeagueId.
    function avatarIdFieldValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarId'])
        || request.resource.data.avatarId in resource.data.unlockedAvatars
        || request.resource.data.avatarId in pvpAvatarsForLeague(resource.data.bestLeagueId);
    }

    function equippedFrameFieldValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['equippedFrame'])
        || request.resource.data.equippedFrame in unlockedFramesForLeague(resource.data.bestLeagueId);
    }

    // The only winReward value any PvP match is ever created with today
    // (see create_match_screen.dart, live_menu_screen.dart,
    // async_menu_screen.dart, friend_challenge_setup_screen.dart) — locking
    // it here stops a modified client from creating a match with a higher
    // stake directly against Firestore. finalizePvpMatch/
    // finalizeAsyncPvpMatch still clamp it server-side too as a backstop.
    function isSanctionedWinReward(value) {
      return value == 2;
    }

    // economyProtectedFields() only locks these down on `update` — `create`
    // only ever fires once per uid (there's no client `delete` on this
    // path, so a doc can't be removed and recreated to hit this branch
    // again short of the Cloud-Function-only deleteMyAccount flow), but
    // without this a modified client could still forge a favorable starting
    // state on that one write: a maxed-out pvpRating/wins1v1 (instantly
    // completing PvP achievements on the very next real win), a fully
    // unlocked avatar/frame set for a brand-new account, etc. Fields with a
    // real legitimate creation-time value (see user_bootstrap.dart's
    // `newUserFields`) must equal that value if present; every other
    // economy-protected field must simply be absent. Purely cosmetic
    // derived text (league name/emoji/color) isn't worth hand-validating
    // here — getting one of those numbers wrong risks breaking real
    // sign-ups, and faking them grants no actual advantage.
    function newUserEconomyFieldsValid() {
      return (!('pvpRating' in request.resource.data) || request.resource.data.pvpRating == 1000)
        && (!('pvpLeagueId' in request.resource.data) || request.resource.data.pvpLeagueId == 'silver')
        && (!('bestLeagueId' in request.resource.data) || request.resource.data.bestLeagueId == 'silver')
        && (!('unlockedAvatars' in request.resource.data) || request.resource.data.unlockedAvatars == [
              'avatar_1', 'avatar_2', 'avatar_3', 'avatar_4',
              'avatar_5', 'avatar_6', 'avatar_7', 'avatar_8'
            ])
        && (!('lifeUnits' in request.resource.data) || request.resource.data.lifeUnits == 10)
        && (!('maxLifeUnits' in request.resource.data) || request.resource.data.maxLifeUnits == 10)
        && (!('lifeRegenSeconds' in request.resource.data) || request.resource.data.lifeRegenSeconds == 150)
        && (!('loginStreak' in request.resource.data) || request.resource.data.loginStreak == 1)
        && (!('gamesPlayed' in request.resource.data) || request.resource.data.gamesPlayed == 0)
        && (!('correctAnswers' in request.resource.data) || request.resource.data.correctAnswers == 0)
        && (!('wrongAnswers' in request.resource.data) || request.resource.data.wrongAnswers == 0)
        && (!('dailyStreak' in request.resource.data) || request.resource.data.dailyStreak == 0)
        && (!('maxDailyStreak' in request.resource.data) || request.resource.data.maxDailyStreak == 0)
        && (!('bestDailyScore' in request.resource.data) || request.resource.data.bestDailyScore == 0)
        && (!('wins1v1' in request.resource.data) || request.resource.data.wins1v1 == 0)
        && (!('losses1v1' in request.resource.data) || request.resource.data.losses1v1 == 0)
        && (!('draws1v1' in request.resource.data) || request.resource.data.draws1v1 == 0)
        && (!('matches1v1' in request.resource.data) || request.resource.data.matches1v1 == 0)
        && (!('currentWinStreak1v1' in request.resource.data) || request.resource.data.currentWinStreak1v1 == 0)
        && (!('bestWinStreak1v1' in request.resource.data) || request.resource.data.bestWinStreak1v1 == 0)
        && (!('pvpAbandonCount' in request.resource.data) || request.resource.data.pvpAbandonCount == 0)
        && !('level' in request.resource.data)
        && !('pvpRatingDelta' in request.resource.data)
        && !('currentPvpSeasonId' in request.resource.data)
        && !('pvpSeasonBestRating' in request.resource.data)
        && !('pvpSeasonBestLeagueId' in request.resource.data)
        && !('pvpSeasonBestLeagueName' in request.resource.data)
        && !('pvpSeasonFinalRating' in request.resource.data)
        && !('pvpSeasonFinalLeagueId' in request.resource.data)
        && !('pvpSeasonFinalLeagueName' in request.resource.data)
        && !('lastRankedXpEarned' in request.resource.data)
        && !('lastRankedCoinsEarned' in request.resource.data)
        && !('lastClaimedPvpSeasonId' in request.resource.data)
        && !('lastPvpSeasonRewardCoins' in request.resource.data)
        && !('lastPvpSeasonRewardCount' in request.resource.data)
        && !('lastPvpSeasonRewardClaimedAt' in request.resource.data)
        && !('leagueScore' in request.resource.data)
        && !('leagueId' in request.resource.data)
        && !('leagueName' in request.resource.data)
        && !('lastDailyPlayed' in request.resource.data)
        && !('pvpCoinsToday' in request.resource.data)
        && !('pvpCoinsDate' in request.resource.data)
        && !('dynamicAvatars' in request.resource.data)
        && !('categoriesExploredCount' in request.resource.data)
        && !('weeklyTopicsCompletedCount' in request.resource.data);
    }

    match /users/{userId} {
      // Deliberately readable by any signed-in player: the friends list,
      // leaderboards and profile views all read other players' docs. That
      // makes every field on it effectively public, so anything private
      // belongs in the subcollection below instead — see /private.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.coins == 0
        && request.resource.data.xp == 0
        && newUserEconomyFieldsValid();

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(economyProtectedFields())
        && avatarIdFieldValid()
        && equippedFrameFieldValid();

      // Per-user data nobody else may read, in contrast to the user doc
      // above. Today that means the FCM push token: it lived on the user
      // doc, so every signed-in player could harvest every other player's
      // token. Owner-only both ways; sendPushOnNotificationCreated reads it
      // with the Admin SDK, which bypasses these rules.
      match /private/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Cloud-Function-only (createAiTopic / ensureAiTopicLevelsGenerated
      // / regenerateAiTopicQuestions / expandAiTopic, Admin SDK — bypasses
      // these rules), same reasoning as /achievements and /friends below:
      // a client with full write access here could forge `status`,
      // `generatedLevels`/`questionsCount`, or write self-authored
      // `levels/*/questions/*` content with a known-correct answerIndex,
      // bypassing every economy/moderation check those functions enforce.
      // The only legitimate client write left is deleteAiTopic's
      // status -> 'deleted' transition.
      match /ai_topics/{topicId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;

        allow create: if false;

        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'deletedAt', 'updatedAt'])
          && request.resource.data.status == 'deleted';

        allow delete: if false;

        match /{document=**} {
          allow read: if request.auth != null
            && request.auth.uid == userId;
          allow write: if false;
        }
      }

      // Cloud-Function-only (submitSoloLevelResult, Admin SDK — bypasses
      // these rules). A client `write` here used to be allowed, but
      // submitSoloLevelResult trusts this doc's own `passedLevels`/
      // `completedLevels`/`categoryRewardGranted` as its record of which
      // level rewards were already granted — a client could rewrite this
      // doc directly to drop a level from `passedLevels` (or reset
      // `categoryRewardGranted`) and re-claim its coin reward indefinitely.
      match /progress_fixed/{docId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      // Cloud-Function-only (ensureSoloLevelSession, Admin SDK — bypasses
      // these rules). A client `create` here used to be allowed on the
      // reasoning that it could only ever write its own session once
      // (LevelPlayScreen._ensureSession, no-op if it already exists) — but
      // submitSoloLevelResult trusts this doc's own stored `questions`
      // (including `answerIndex`) as ground truth, so a client `create`
      // could write self-chosen "correct" answers unrelated to the real
      // fixed_pools content and farm rewards. ensureSoloLevelSession now
      // selects the question set server-side against fixed_pools instead.
      match /sessions_fixed/{docId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      // Same reasoning as /progress_fixed above.
      match /progress_ai/{topicId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      // Which AI-topic questions this player has already been served, so
      // ensureSoloLevelSession can draw an unseen slate on a replay.
      // Cloud-Function-only on purpose: when a level's bank runs dry the
      // server tops it up with a real (paid) Claude call, so a client
      // able to clear this could force generation on repeat and spend
      // real API money. AI_QUESTION_BANK_CAP bounds that too, but this
      // closes it outright.
      match /ai_topic_seen/{topicId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      // Same reasoning as /sessions_fixed above, against
      // ai_topics/*/levels/*/questions instead of fixed_pools.
      match /sessions_ai/{sessionId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      // Same reasoning as /sessions_fixed above — the client used to read
      // the real fixed-pool question data and write its own copy straight
      // into this doc, which submitDailyChallengeResult then trusted as
      // ground truth. Only ensureDailyChallengeSession (Cloud Function,
      // creates it once, no-op if it already exists) and
      // submitDailyChallengeResult now write it.
      match /daily_challenges/{dateId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      // weeklyScore here feeds weekly-league season reward payouts
      // (claimWeeklySeasonRewards) — only submitDailyChallengeResult
      // (Cloud Function, Admin SDK) may write it now, so a client can no
      // longer forge its own weekly ranking to claim a bigger reward.
      match /weekly_participation/{weekId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      // claimed/rewardCoins here are Cloud-Function-only too, otherwise a
      // client could reset its own `claimed` flag to re-claim the same
      // season's reward repeatedly.
      match /season_history/{seasonId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      match /pvp_season_history/{seasonId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      match /pvp_season_stats/{seasonId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      match /match_history/{historyId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      // Cloud-Function-only. Every achievement's progress now has a
      // trustworthy server-side source (PvP wins/streak via
      // finalizePvpMatch, daily streak via submitDailyChallengeResult,
      // solo levels via submitSoloLevelResult, friend count via
      // acceptFriendRequest) — the client has no legitimate write left
      // here. Previously this allowed client writes (needed before that
      // migration), which also meant a modified client could forge
      // `completed`/`progress`, or reset `claimed` to false after a real
      // claimAchievementReward call to re-claim the same reward forever.
      match /achievements/{achievementId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      // Cloud-Function-only (acceptFriendRequest/removeFriend in
      // functions/src/index.ts) — the previous rule let either side of a
      // friendship write here (needed so accepting could write both mirror
      // docs in one go), but that also let a client fabricate a "friend"
      // doc directly with no real request ever sent or accepted.
      match /friends/{friendId} {
        allow read: if request.auth != null
          && (
            request.auth.uid == userId ||
            request.auth.uid == friendId
          );
        allow write: if false;
      }

      // `create`/`update` used to also allow `auth.uid == userId` (the
      // inbox owner, i.e. the request's target) — that let a client write
      // an arbitrary `requesterId` into their own inbox with no real
      // request ever sent, then `acceptFriendRequest` it to fabricate a
      // friendship and farm the friends_5/friends_10 achievements. Only
      // the real requester may write their own entry now (still covers
      // the legitimate "resend after rejection" case, since that's an
      // update by the same requester); accepting/rejecting is
      // Cloud-Function-only (acceptFriendRequest/rejectFriendRequest,
      // Admin SDK — bypasses this rule).
      match /friend_requests/{requesterId} {
        allow read: if request.auth != null
          && (
            request.auth.uid == userId ||
            request.auth.uid == requesterId
          );

        allow create, update: if request.auth != null
          && request.auth.uid == requesterId;

        allow delete: if false;
      }

      // Same reasoning as /friend_requests above — `create`/`update` used
      // to also allow `auth.uid == targetId` (needed when accept/reject
      // still wrote both mirror docs directly from the client), but that
      // let a client write into a *stranger's* outgoing-requests list.
      // Now only the collection owner (the actual sender) writes here;
      // the target's side of accept/reject is Cloud-Function-only.
      match /sent_friend_requests/{targetId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId;

        allow delete: if false;
      }

      // `create` used to be open to any signed-in user, because notifying
      // another player (friend request, match invite, your turn...) was a
      // direct client write into *their* inbox. Since creating a document
      // here fires sendPushOnNotificationCreated, that made "push arbitrary
      // text to any user" a client capability — and uids are enumerable,
      // since /users is readable by anyone signed in. Cross-user
      // notifications now go through the sendUserNotification Cloud
      // Function (Admin SDK — bypasses these rules), which checks the
      // sender earned the right to notify and composes the wording itself.
      // Self-notifications stay client-writable: the worst they can do is
      // spam their own inbox.
      //
      // The old second `allow update` clause (type unchanged + read false,
      // with no owner check) is gone too. `allow` clauses are OR'd, so it
      // never narrowed the owner rule above it — it *widened* the path to
      // let anyone rewrite the title/body of anyone's notification. It
      // existed for createOrBumpUniqueUnreadNotification, which had no
      // callers left and was removed with it.
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null
          && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Cloud-Function-only (submitDailyChallengeResult, Admin SDK — bypasses
    // these rules), same migration as /weekly_leagues below. The client used
    // to publish its own row here and the rule never validated `score`, so a
    // modified client could post any number it liked to the public board.
    // Nothing server-side reads this collection, so a forged row never
    // reached a payout — but the daily ranking is a headline social feature
    // and it was trivially fakeable. The client only reads it now
    // (daily_leaderboard_screen, profile_screen, friends_screen).
    match /daily_leaderboards/{dateId}/players/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // weeklyScore/leagueId/leagueName/level/streak feed weekly-league
    // season reward payouts (claimWeeklySeasonRewards) — only
    // submitDailyChallengeResult (Cloud Function) may write those, so a
    // client can no longer fabricate its own leaderboard entry to claim an
    // inflated reward. The player may still touch their own doc's cosmetic
    // mirror fields directly (username/displayName/avatarId/equippedFrame),
    // so editing your profile mid-week updates the weekly board immediately
    // instead of waiting for the next daily-challenge play.
    match /weekly_leagues/{weekId}/{leagueId}/{playerId} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null
        && request.auth.uid == playerId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['username', 'displayName', 'avatarId', 'equippedFrame', 'updatedAt']);
      allow delete: if false;
    }

    // Matches are 1v1 — only the two players in a match may read or write
    // it. `create` covers both a fresh match (creator lists themself as
    // hostUid) and a rematch doc (creator may be listed as guestUid,
    // since either player can trigger rematch creation). `update` also
    // allows a brand-new joiner to claim an empty guestUid slot — though
    // that path is now Cloud-Function-only in practice too (joinMatchByCode,
    // Admin SDK) since the client could never actually read a match it
    // wasn't host/guest on yet to join it in the first place; this clause
    // stays as a fallback for any future client-side join path.
    // `questions` is locked immutable post-creation — finalizePvpMatch now
    // recomputes each player's real score from their `players.{uid}.answers`
    // against this exact array, so a player rewriting it mid-match (e.g. to
    // questions they already know the answers to) would otherwise let them
    // rig their own result. `winnerUid`/`finishReason`/`rewarded` are
    // Cloud-Function-only too (finalizePvpMatch / claimOpponentDisconnected)
    // — a client used to be able to write these directly (the old
    // forceFinishMatchByDisconnect flow), which let a losing player
    // self-declare a win and get their opponent hit with a rating penalty
    // with zero server verification anyone actually disconnected.
    match /matches/{matchId} {
      allow read: if request.auth != null
        && (
          request.auth.uid == resource.data.hostUid ||
          request.auth.uid == resource.data.guestUid
        );

      allow create: if request.auth != null
        && (
          request.auth.uid == request.resource.data.hostUid ||
          request.auth.uid == request.resource.data.guestUid
        )
        && isSanctionedWinReward(request.resource.data.winReward);

      allow update: if request.auth != null
        && (
          request.auth.uid == resource.data.hostUid ||
          request.auth.uid == resource.data.guestUid ||
          (
            resource.data.guestUid == null &&
            request.resource.data.guestUid == request.auth.uid &&
            request.resource.data.guestUid != resource.data.hostUid
          )
        )
        && request.resource.data.winReward == resource.data.winReward
        && request.resource.data.questions == resource.data.questions
        && request.resource.data.winnerUid == resource.data.winnerUid
        && request.resource.data.finishReason == resource.data.finishReason
        && request.resource.data.rewarded == resource.data.rewarded
        // A player may only touch their own entry in `players`. Locking
        // `questions` above stops someone swapping in questions they know,
        // but finalizePvpMatch scores each side from `players.{uid}.answers`
        // — so without this, either player could rewrite the *opponent's*
        // answers to wrong ones and hand themselves a verified win, rating
        // and rewards included. Every legitimate client write here is
        // `players.$uid.{ready,answers,score,finished,finishedAt}` (see
        // match_service.dart), so restricting the diff to the caller's own
        // key costs nothing and closes it.
        && request.resource.data.players.diff(resource.data.players)
            .affectedKeys().hasOnly([request.auth.uid]);
    }

    // The "current" weekly topic (and its rewardCoins/rewardAvatarId) is
    // admin-authored config, read by every player — client write access
    // here would let anyone inflate their own claimed reward via
    // claimWeeklyTopicCoinReward/claimWeeklyTopicCompletionReward.
    match /weekly_topics/{topicId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Same reasoning as /matches — only the challenger and the challenged
    // player may read or write an async match. Both UIDs are always set
    // at creation (no open "guest slot" here), so create/update only need
    // the participant check, no empty-slot claim clause. `questions` is
    // locked immutable post-creation for the same reason as /matches —
    // finalizeAsyncPvpMatch recomputes scores from `answers` against it.
    match /async_matches/{matchId} {
      allow read: if request.auth != null
        && (
          request.auth.uid == resource.data.challengerUid ||
          request.auth.uid == resource.data.challengedUid
        );

      allow create: if request.auth != null
        && (
          request.auth.uid == request.resource.data.challengerUid ||
          request.auth.uid == request.resource.data.challengedUid
        )
        && request.resource.data.challengerUid
            != request.resource.data.challengedUid
        && isSanctionedWinReward(request.resource.data.winReward);

      allow update: if request.auth != null
        && (
          request.auth.uid == resource.data.challengerUid ||
          request.auth.uid == resource.data.challengedUid
        )
        && request.resource.data.winReward == resource.data.winReward
        && request.resource.data.questions == resource.data.questions
        // Same hole as /matches, different shape: answers live in the
        // top-level `challenger`/`challenged` maps here, and
        // finalizeAsyncPvpMatch scores each side from its own map. Whichever
        // side you are, the other one has to come back untouched.
        && (request.auth.uid == resource.data.challengerUid
              ? request.resource.data.challenged == resource.data.challenged
              : request.resource.data.challenger == resource.data.challenger);
    }

    match /realtime_invites/{inviteId} {
      allow read: if request.auth != null
        && (
          request.auth.uid == resource.data.fromUid ||
          request.auth.uid == resource.data.toUid
        );

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid;

      allow update: if request.auth != null
        && (
          request.auth.uid == resource.data.fromUid ||
          request.auth.uid == resource.data.toUid
        );

      allow delete: if false;
    }

    // Cloud-Function-only for anything cross-user (tryFindLiveOpponent,
    // Admin SDK) — pairing used to happen client-side, which meant even a
    // narrowly-scoped update rule still had to let a client write a
    // "you've been matched" claim onto another player's doc, and couldn't
    // fully stop a fake matchId being planted on an actively-searching
    // victim's entry. Now the client only ever touches its own queue doc.
    match /live_search/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == docId;
    }
  }
}
